# Copy to .env for local development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/healthdash
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/healthdash
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/healthdash

# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
